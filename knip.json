{
	"entry": ["src/cli.ts", "src/server/index.ts", "src/mcp/server.ts", "src/web/main.tsx", "scripts/**/*.cjs"],
	"project": ["src/**/*.ts"],
	"ignore": ["src/test/**", "src/completions/**"],
	"ignoreDependencies": [
		"shell-quote",
		"yaml",
		"tailwindcss",
		"@tailwindcss/cli",
		"@types/shell-quote",
		"@uiw/react-markdown-preview",
		"@uiw/react-md-editor",
		"@opentui/core",
		"react-tooltip"
	],
	"ignoreBinaries": [
		"backlog",
		"task",
		"doc",
		"decision",
		"agents",
		"init",
		"draft",
		"search",
		"config",
		"where",
		"which",
		"prek"
	],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	}
}
