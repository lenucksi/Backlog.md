{
	"name": "backlog.md",
	"version": "1.5.0",
	"type": "module",
	"module": "src/cli.ts",
	"files": [
		"scripts/*.cjs",
		"hooks/backlog-guard/*.js",
		"hooks/backlog-guard/guard.sh",
		"hooks/backlog-guard/README.md",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"backlog": "scripts/cli.cjs"
	},
	"optionalDependencies": {
		"backlog.md-darwin-arm64": "^1.47.1",
		"backlog.md-darwin-x64": "^1.47.1",
		"backlog.md-linux-arm64": "^1.47.1",
		"backlog.md-linux-x64": "^1.47.1",
		"backlog.md-windows-x64": "^1.47.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/cli": "4.2.2",
		"@termless/core": "^0.6.0",
		"@types/bun": "1.3.12",
		"@types/jsdom": "28.0.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-router-dom": "5.3.3",
		"@types/shell-quote": "^1.7.5",
		"@uiw/react-markdown-preview": "5.2.0",
		"@uiw/react-md-editor": "4.1.0",
		"@vitejs/plugin-react": "^6.0.3",
		"commander": "^15.0.0",
		"dependency-cruiser": "^17.4.3",
		"fuse.js": "7.3.0",
		"jsdom": "29.0.2",
		"knip": "^6.24.0",
		"mermaid": "11.14.0",
		"neo-neo-bblessed": "1.0.9",
		"picocolors": "1.1.1",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-router-dom": "7.14.1",
		"react-tooltip": "5.30.1",
		"tailwindcss": "4.2.2",
		"vite": "^8.1.3",
		"vterm.js": "^0.4.0"
	},
	"scripts": {
		"test": "bun test --parallel --timeout=20000 --path-ignore-patterns='worktrees/*' --path-ignore-patterns='src/test/e2e/*' --path-ignore-patterns='src/test/tui-interactive-editor-handoff.test.ts' --path-ignore-patterns='src/test/runtime-cwd.test.ts'",
		"test:fails": "bun test --only-failures --parallel --timeout=20000 --path-ignore-patterns='worktrees/*' --path-ignore-patterns='src/test/e2e/*' --path-ignore-patterns='src/test/tui-interactive-editor-handoff.test.ts' --path-ignore-patterns='src/test/runtime-cwd.test.ts'",
		"test:interactive": "RUN_INTERACTIVE_TUI_TESTS=1 bun test --parallel --timeout=30000 --path-ignore-patterns='worktrees/*' --path-ignore-patterns='src/test/e2e/*' --path-ignore-patterns='src/test/tui-interactive-editor-handoff.test.ts' --path-ignore-patterns='src/test/runtime-cwd.test.ts'",
		"test:interactive:fails": "RUN_INTERACTIVE_TUI_TESTS=1 bun test --only-failures --parallel --timeout=30000 --path-ignore-patterns='worktrees/*' --path-ignore-patterns='src/test/e2e/*' --path-ignore-patterns='src/test/tui-interactive-editor-handoff.test.ts' --path-ignore-patterns='src/test/runtime-cwd.test.ts'",
		"test:ci": "CI=true bun test --parallel --timeout=10000 --path-ignore-patterns='worktrees/*' --path-ignore-patterns='src/test/e2e/*' --path-ignore-patterns='src/test/tui-interactive-editor-handoff.test.ts' --path-ignore-patterns='src/test/runtime-cwd.test.ts'",
		"test:interactive:handoff": "RUN_INTERACTIVE_TUI_TESTS=1 bun test src/test/tui-interactive-editor-handoff.test.ts --timeout=30000",
		"test:interactive:handoff:fails": "RUN_INTERACTIVE_TUI_TESTS=1 bun test --only-failures src/test/tui-interactive-editor-handoff.test.ts --timeout=30000",
		"test:e2e": "bun run build:css && bun x playwright test",
		"test:e2e:ui": "bun run build:css && bun x playwright test --ui",
		"test:e2e:debug": "bun run build:css && bun x playwright test --debug",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check .",
		"check:types": "bun x tsc -p tsconfig.tsc.json --noEmit",
		"check:types-go": "bun x -p typescript@rc tsc -p tsconfig.tsc.json --noEmit",
		"prepare": "prek install 2>/dev/null || true",
		"build:css": "bun ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/web/styles/source.css -o src/web/styles/style.css --minify",
		"guard:test": "bun test hooks/backlog-guard/guard-core.test.ts",
		"guard:build": "bun build hooks/backlog-guard/opencode-plugin.ts --outfile hooks/backlog-guard/opencode-plugin.js --target=node --format=esm && bun build hooks/backlog-guard/claude-hook.ts --outfile hooks/backlog-guard/claude-hook.js --target=node --format=esm --external=yaml --external=shell-quote",
		"guard:dev": "bun run guard:test && bun run guard:build",
		"dev": "bun run scripts/dev.ts",
		"dev:server": "bun --watch src/cli.ts browser --non-interactive --no-open",
		"build": "bun run scripts/build.ts",
		"cli": "bun run build:css && bun src/cli.ts",
		"mcp": "bun src/cli.ts mcp start",
		"update-nix": "sh scripts/update-nix.sh",
		"postinstall": "bash scripts/postinstall.sh"
	},
	"author": "Alex Gavrilescu (https://github.com/MrLesk)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrLesk/Backlog.md.git"
	},
	"bugs": {
		"url": "https://github.com/MrLesk/Backlog.md/issues"
	},
	"homepage": "https://backlog.md",
	"keywords": [
		"cli",
		"markdown",
		"kanban",
		"task",
		"project-management",
		"backlog",
		"agents"
	],
	"license": "MIT",
	"trustedDependencies": [
		"@biomejs/biome",
		"node-pty"
	],
	"dependencies": {
		"@clack/core": "1.2.0",
		"@clack/prompts": "1.2.0",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/swagger": "^1.3.1",
		"@opentui/core": "^0.4.3",
		"@opentui/solid": "^0.4.3",
		"consola": "^3.4.2",
		"elysia": "^1.4.29",
		"shell-quote": "^1.9.0",
		"solid-js": "^1.9.14",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"yaml": "^2.9.0"
	},
	"patchedDependencies": {
		"@termless/xtermjs@0.3.1": "patches/@termless%2Fxtermjs@0.3.1.patch"
	}
}
