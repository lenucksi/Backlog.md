{
	"name": "backlog.md",
	"version": "1.5.0",
	"type": "module",
	"module": "src/cli.ts",
	"files": [
		"scripts/*.cjs",
		"hooks/backlog-guard/*.js",
		"hooks/backlog-guard/guard.sh",
		"hooks/backlog-guard/README.md",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"backlog": "scripts/cli.cjs"
	},
	"optionalDependencies": {
		"backlog.md-darwin-arm64": "*",
		"backlog.md-darwin-x64": "*",
		"backlog.md-linux-arm64": "*",
		"backlog.md-linux-x64": "*",
		"backlog.md-windows-x64": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@clack/core": "1.2.0",
		"@clack/prompts": "1.2.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/cli": "4.2.2",
		"@termless/core": "^0.6.0",
		"@types/bun": "1.3.12",
		"@types/jsdom": "28.0.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-router-dom": "5.3.3",
		"@types/shell-quote": "^1.7.5",
		"@uiw/react-markdown-preview": "5.2.0",
		"@uiw/react-md-editor": "4.1.0",
		"commander": "14.0.3",
		"dependency-cruiser": "^17.4.0",
		"fuse.js": "7.3.0",
		"install": "0.13.0",
		"jsdom": "29.0.2",
		"knip": "^6.14.1",
		"mermaid": "11.14.0",
		"neo-neo-bblessed": "1.0.9",
		"picocolors": "1.1.1",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-router-dom": "7.14.1",
		"react-tooltip": "5.30.1",
		"tailwindcss": "4.2.2",
		"vterm.js": "^0.4.0"
	},
	"scripts": {
		"test": "bun test --timeout=10000 --path-ignore-patterns='worktrees/*'",
		"test:fails": "bun test --only-failures --timeout=10000 --path-ignore-patterns='worktrees/*'",
		"test:interactive": "RUN_INTERACTIVE_TUI_TESTS=1 bun test --timeout=30000 --path-ignore-patterns='worktrees/*'",
		"test:interactive:fails": "RUN_INTERACTIVE_TUI_TESTS=1 bun test --only-failures --timeout=30000 --path-ignore-patterns='worktrees/*'",
		"test:ci": "CI=true bun test --timeout=10000 --path-ignore-patterns='worktrees/*'",
		"test:interactive:handoff": "RUN_INTERACTIVE_TUI_TESTS=1 bun test src/test/tui-interactive-editor-handoff.test.ts --timeout=30000",
		"test:interactive:handoff:fails": "RUN_INTERACTIVE_TUI_TESTS=1 bun test --only-failures src/test/tui-interactive-editor-handoff.test.ts --timeout=30000",
		"test:e2e": "lsof -ti:6420 | xargs kill -9 2>/dev/null; bun run build:css && bunx playwright test",
		"test:e2e:ui": "lsof -ti:6420 | xargs kill -9 2>/dev/null; bun run build:css && bunx playwright test --ui",
		"test:e2e:debug": "lsof -ti:6420 | xargs kill -9 2>/dev/null; bun run build:css && bunx playwright test --debug",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check .",
		"check:types": "bunx tsc --noEmit",
		"prepare": "prek install 2>/dev/null || true",
		"build:css": "bun ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/web/styles/source.css -o src/web/styles/style.css --minify",
		"guard:test": "bun test hooks/backlog-guard/guard-core.test.ts",
		"guard:build": "bun build hooks/backlog-guard/opencode-plugin.ts --outfile hooks/backlog-guard/opencode-plugin.js --target=node --format=esm && bun build hooks/backlog-guard/claude-hook.ts --outfile hooks/backlog-guard/claude-hook.js --target=node --format=esm --external=yaml --external=shell-quote",
		"guard:dev": "bun run guard:test && bun run guard:build",
		"build:guard": "bun run guard:build",
		"build": "bun run scripts/build.ts",
		"cli": "bun run build:css && bun src/cli.ts",
		"mcp": "bun src/cli.ts mcp start",
		"update-nix": "sh scripts/update-nix.sh",
		"postinstall": "sh -c 'command -v bun2nix >/dev/null 2>&1 && bun2nix -o bun.nix || (command -v nix >/dev/null 2>&1 && nix --extra-experimental-features \"nix-command flakes\" run github:baileyluTCD/bun2nix/85d692d68a5345d868d3bb1158b953d2996d70f7 -- -o bun.nix || true)'"
	},
	"author": "Alex Gavrilescu (https://github.com/MrLesk)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrLesk/Backlog.md.git"
	},
	"bugs": {
		"url": "https://github.com/MrLesk/Backlog.md/issues"
	},
	"homepage": "https://backlog.md",
	"keywords": [
		"cli",
		"markdown",
		"kanban",
		"task",
		"project-management",
		"backlog",
		"agents"
	],
	"license": "MIT",
	"trustedDependencies": [
		"@biomejs/biome",
		"node-pty"
	],
	"dependencies": {
		"@xenova/transformers": "^2.17.2",
		"shell-quote": "^1.8.3",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"yaml": "^2.9.0"
	},
	"patchedDependencies": {
		"@termless/xtermjs@0.3.1": "patches/@termless%2Fxtermjs@0.3.1.patch"
	}
}
