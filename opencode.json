{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"backlog": {
			"type": "local",
			"command": ["./dist/backlog", "mcp", "start"],
			"enabled": true
		},
		"sonarqube": {
			"type": "local",
			"command": [
				"docker", "run", "--init", "--pull=always", "-i", "--rm",
				"-e", "SONARQUBE_TOKEN",
				"-e", "SONARQUBE_ORG",
				"-v", "{env:PWD}:/app/mcp-workspace",
				"mcp/sonarqube"
			],
			"enabled": true,
			"environment": {
				"SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
				"SONARQUBE_ORG": "lenucksi"
			}
		}
	},
	"plugin": ["./hooks/backlog-guard/opencode-plugin.js"]
}
